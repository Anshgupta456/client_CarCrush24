# =====================================================================
# CarCrush24 Backend Environment Configuration
# Copy this file to .env and update the values for your environment.
# =====================================================================

# Server Port
# Local development: 5000
# Production EC2 (if port 5000 is occupied by portfolio): 5001
PORT=5000

# Express Request Body Size Limit (for rich text, JSON payloads, base64 images)
BODY_LIMIT=50mb

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.8qdnlap.mongodb.net/carcrush?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/carcrush?retryWrites=true&w=majority

# JWT Secret Key for Admin Authentication
JWT_SECRET=carcrush24_jwt_super_secret_key_change_in_production

# Frontend Client URLs for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,http://localhost:3001,https://carcrush.anshikagupta.online

# Initial Superadmin Credentials (used during automatic seed if no admin exists)
ADMIN_INITIAL_EMAIL=admin@carcrush24.com
ADMIN_INITIAL_PASSWORD=admin123

# Admin Notification WhatsApp Number (country code + phone, no '+' or spaces)
ADMIN_WHATSAPP_NUMBER=917310242424

# Optional: Google Analytics 4 Reporting API (Service Account)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Optional: SMTP Email Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
