# =====================================================================
# CarCrush24 Frontend Environment Configuration
# Copy this file to .env.local (or .env.production on production server).
# =====================================================================

# Backend API URL
# Where Next.js rewrites proxy /api/* requests to the Express backend.
# Local development: http://localhost:5000 (or http://localhost:5001 if backend runs on 5001)
# Production EC2: http://localhost:5001
BACKEND_URL=http://localhost:5000

# Client-Side API Base URL (optional fallback)
NEXT_PUBLIC_API_URL=http://localhost:5000

# WhatsApp Click-to-Chat number for customer quote inquiries
# Format with country code without '+' or special characters (e.g. 917310242424)
NEXT_PUBLIC_WHATSAPP_NUMBER=917310242424

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
